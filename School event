<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>পুনর্মিলনী অনুষ্ঠান - জে জে আই নিম্ন মাধ্যমিক বিদ্যালয়</title>
    <!-- Tailwind CSS CDN (for modern design) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Hind Siliguri', sans-serif; }
        .bg-donation { background-color: #fdf2f2; }
    </style>
</head>
<body class="bg-slate-100 text-gray-800">

    <!-- Header / Banner Section -->
    <header class="bg-gradient-to-r from-teal-800 to-emerald-700 text-white py-12 px-4 shadow-xl text-center">
        <div class="max-w-4xl mx-auto">
            <span class="bg-amber-400 text-teal-950 font-bold text-xs md:text-sm px-3 py-1 rounded-full uppercase tracking-wider">ঐতিহ্যের ৪৪ বছর (১৯৮২ - ২০২৬)</span>
            <h1 class="text-3xl md:text-5xl font-extrabold my-4 leading-tight">প্রাক্তন শিক্ষার্থী মহা পুনর্মিলনী</h1>
            <p class="text-xl md:text-2xl font-semibold text-emerald-200">জে জে আই নিম্ন মাধ্যমিক বিদ্যালয়</p>
            <p class="text-sm md:text-base mt-1 opacity-90">রাজঘাট, অভয়নগর, যশোর</p>
        </div>
    </header>

    <div class="max-w-5xl mx-auto px-4 py-10 space-y-10">

        <!-- Info Cards Section -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-teal-100 text-center hover:shadow-md transition">
                <div class="text-4xl mb-3">📅</div>
                <h3 class="font-bold text-lg text-teal-900 mb-1">অনুষ্ঠানের তারিখ</h3>
                <p class="text-gray-600 text-sm">খুব শীঘ্রই জানানো হবে</p>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-teal-100 text-center hover:shadow-md transition">
                <div class="text-4xl mb-3">📍</div>
                <h3 class="font-bold text-lg text-teal-900 mb-1">ভেন্যু / স্থান</h3>
                <p class="text-gray-600 text-sm">স্কুল প্রাঙ্গণ, রাজঘাট, অভয়নগর, যশোর</p>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-teal-100 text-center hover:shadow-md transition">
                <div class="text-4xl mb-3">🎓</div>
                <h3 class="font-bold text-lg text-teal-900 mb-1">অংশগ্রহণকারী ব্যাচ</h3>
                <p class="text-gray-600 text-sm">১৯৮২ থেকে ২০২৬ সালের সকল শিক্ষার্থী</p>
            </div>
        </div>

        <!-- Invitation Message -->
        <section class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-slate-200">
            <h2 class="text-2xl font-bold text-teal-900 border-b-2 border-teal-500 pb-2 mb-4 inline-block">স্মৃতির আঙিনায় আমন্ত্রণ</h2>
            <p class="text-gray-700 leading-relaxed text-base md:text-lg">
                ১৯৮২ সালে প্রতিষ্ঠিত আমাদের প্রিয় **জে জে আই নিম্ন মাধ্যমিক বিদ্যালয়** পেরিয়ে গেছে সফলতার ৪৪টি বছর। ১৯৮২ থেকে ২০২৬ সাল পর্যন্ত এই দীর্ঘ যাত্রায় যারা এই প্রাঙ্গণে শৈশব ও কৈশোরের দিনগুলো কাটিয়েছেন, তাদের সবাইকে এক ছাদের নিচে ফিরিয়ে আনতেই এই মহতী উদ্যোগ। পুরনো বন্ধুদের জড়িয়ে ধরা, প্রিয় শিক্ষকদের শ্রদ্ধা জানানো আর স্মৃতির ঝাঁপি খুলে বসার এই মাহেন্দ্রক্ষণে আপনাকে সাদর আমন্ত্রণ।
            </p>
        </section>

        <!-- (NEW) Donation & Payment Section -->
        <section class="bg-white p-6 md:p-10 rounded-2xl shadow-sm border border-red-200 bg-donation">
            <div class="text-center mb-8">
                <div class="text-5xl mb-3">🎁</div>
                <h2 class="text-3xl font-bold text-red-900">অনুদান ও আর্থিক সহায়তা</h2>
                <p class="text-gray-600 mt-2 text-base md:text-lg">আমাদের এই মহৎ আয়োজনকে সফল করতে আপনিও স্বেচ্ছায় আর্থিক অনুদান দিয়ে অংশগ্রহণ করতে পারেন। আপনার ভালোবাসার উপহার আমাদের এই মিলনমেলাকে আরও প্রাণবন্ত করবে।</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-10">
                <!-- Mobile Banking Details -->
                <div class="bg-white p-6 rounded-xl shadow border border-gray-100">
                    <h4 class="font-bold text-lg text-gray-900 mb-4 border-b pb-2">মোবাইল ব্যাংকিং (Personal)</h4>
                    <div class="space-y-4">
                        <div class="flex items-center gap-3">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/8/8e/Bkash_logo_%28without_text%29.svg/100px-Bkash_logo_%28without_text%29.svg.png" alt="bKash" class="w-10 h-10 object-contain">
                            <div>
                                <p class="font-semibold text-gray-800">বিকাশ (bKash)</p>
                                <p class="text-sm text-gray-600">নম্বর: <span class="font-mono text-base text-gray-900">01XXXXXXXXX</span> (Personal)</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/3/36/Nagad_logo.svg/120px-Nagad_logo.svg.png" alt="Nagad" class="w-10 h-10 object-contain">
                            <div>
                                <p class="font-semibold text-gray-800">নগদ (Nagad)</p>
                                <p class="text-sm text-gray-600">নম্বর: <span class="font-mono text-base text-gray-900">01XXXXXXXXX</span> (Personal)</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <img src="https://www.dutchbanglabank.com/img/rocket_logo.png" alt="Rocket" class="w-10 h-10 object-contain">
                            <div>
                                <p class="font-semibold text-gray-800">রকেট (Rocket)</p>
                                <p class="text-sm text-gray-600">নম্বর: <span class="font-mono text-base text-gray-900">01XXXXXXXXX</span> (Personal)</p>
                            </div>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-4">* অনুদান পাঠানোর পর অনুগ্রহ করে মোবাইল নম্বরটি কনফার্ম করুন।</p>
                </div>

                <!-- Bank Account Details -->
                <div class="bg-white p-6 rounded-xl shadow border border-gray-100">
                    <h4 class="font-bold text-lg text-gray-900 mb-4 border-b pb-2">ব্যাংক অ্যাকাউন্ট বিবরণ</h4>
                    <div class="space-y-3">
                        <div>
                            <p class="font-semibold text-gray-800">অ্যাকাউন্ট নাম:</p>
                            <p class="text-gray-700 bg-gray-50 p-2 rounded">জে জে আই স্কুল পুনর্মিলনী ফান্ড</p>
                        </div>
                        <div>
                            <p class="font-semibold text-gray-800">অ্যাকাউন্ট নম্বর:</p>
                            <p class="text-gray-900 font-mono bg-gray-50 p-2 rounded">XXXXXXXXXXXXX</p>
                        </div>
                        <div>
                            <p class="font-semibold text-gray-800">ব্যাংকের নাম:</p>
                            <p class="text-gray-700 bg-gray-50 p-2 rounded">সোনালী ব্যাংক পিএলসি / ডাচ-বাংলা ব্যাংক</p>
                        </div>
                        <div>
                            <p class="font-semibold text-gray-800">শাখা & রাউটিং নম্বর:</p>
                            <p class="text-gray-700 bg-gray-50 p-2 rounded">অভয়নগর শাখা, যশোর। রাউটিং: XXXXXXXX</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Registration Form Section -->
        <section class="bg-white p-6 md:p-10 rounded-2xl shadow-sm border border-slate-200">
            <div class="text-center mb-8">
                <h2 class="text-3xl font-bold text-teal-900">অনলাইন রেজিস্ট্রেশন ফর্ম</h2>
                <p class="text-gray-500 mt-1 text-sm">অনুষ্ঠানে অংশগ্রহণ নিশ্চিত করতে ফর্মটি সঠিকভাবে পূরণ করুন</p>
            </div>
            
            <form action="#" method="POST" class="space-y-6">
                <!-- Personal Info -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-gray-700 font-semibold mb-2">পূর্ণ নাম (বাংলা বা ইংরেজিতে) *</label>
                        <input type="text" required placeholder="আপনার নাম লিখুন" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-gray-700 font-semibold mb-2">মোবাইল নম্বর *</label>
                        <input type="tel" required placeholder="01XXXXXXXXX" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:outline-none">
                    </div>
                </div>

                <!-- Batch Selection (1982 to 2026) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-gray-700 font-semibold mb-2">পাস করার বছর / ব্যাচ নির্বাচন করুন *</label>
                        <select id="batchSelect" required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:outline-none bg-white">
                            <option value="">ব্যাচ সিলেক্ট করুন</option>
                            <!-- Script will populate 1982 to 2026 -->
                        </select>
                    </div>
                    <div>
                        <label class="block text-gray-700 font-semibold mb-2">বর্তমান পেশা / কর্মক্ষেত্র</label>
                        <input type="text" placeholder="যেমন: ব্যবসা, সরকারি/বেসরকারি চাকরি, শিক্ষার্থী" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-gray-700 font-semibold mb-2">বর্তমান ঠিকানা</label>
                        <input type="text" placeholder="গ্রাম/শহর, জেলা" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-gray-700 font-semibold mb-2">টি-শার্ট সাইজ (T-Shirt Size) *</label>
                        <select required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:outline-none bg-white">
                            <option value="">সাইজ বেছে নিন</option>
                            <option value="M">Medium (M)</option>
                            <option value="L">Large (L)</option>
                            <option value="XL">Extra Large (XL)</option>
                            <option value="XXL">Double Extra Large (XXL)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-gray-700 font-semibold mb-2">অতিরিক্ত মেহমান বা অতিথি সংখ্যা (যদি থাকে)</label>
                    <input type="number" min="0" value="0" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:outline-none">
                </div>

                <button type="submit" class="w-full bg-teal-700 hover:bg-teal-800 text-white font-bold py-4 rounded-xl transition shadow-lg text-lg">
                    রেজিস্ট্রেশন সম্পূর্ণ করুন
                </button>
            </form>
        </section>

    </div>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 py-8 text-center text-sm border-t border-gray-800">
        <p class="font-medium text-gray-300">© ২০২৬ জে জে আই নিম্ন মাধ্যমিক বিদ্যালয় পুনর্মিলনী কমিটি</p>
        <p class="mt-1">রাজঘাট, অভয়নগর, যশোর | যোগাযোগের জন্য: ০১৭XXXXXXXX</p>
    </footer>

    <!-- JavaScript to automatically generate Batch Options (1982 to 2026) -->
    <script>
        const batchSelect = document.getElementById('batchSelect');
        const startYear = 1982;
        const endYear = 2026;

        // Populate dropdown from 2026 down to 1982
        for (let year = endYear; year >= startYear; year--) {
            const option = document.createElement('option');
            option.value = year;
            option.textContent = year + ' ব্যাচ';
            batchSelect.appendChild(option);
        }
    </script>
</body>
</html>
